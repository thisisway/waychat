{
  "name": "@waychat/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/test-db.d.ts",
      "default": "./dist/test-db.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node dist/migrate-cli.js"
  },
  "dependencies": {
    "@waychat/shared": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.1.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11"
  },
  "files": [
    "dist",
    "drizzle"
  ]
}
