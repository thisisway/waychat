# Copie para .env. NUNCA commite o .env. Valores abaixo são só para desenvolvimento local.
# Portas do host (5462/6409/9030/9031) evitam conflito com outros projetos locais que usam as padrão.
# Gere segredos reais com: openssl rand -base64 32

NODE_ENV=development
LOG_LEVEL=info
PUBLIC_URL=http://localhost:5173
# Endereço do painel (Vite em desenvolvimento). Usado na checagem de Origin/CORS e para marcar cookies como Secure quando for https.
API_PORT=3000
# Só true atrás de um proxy confiável (Caddy): passa a confiar em X-Forwarded-For para o IP do cliente.
TRUST_PROXY=false
# /metrics do Prometheus em portas separadas da API pública. Não exponha na internet.
METRICS_HOST=127.0.0.1
METRICS_PORT=9464
WORKER_METRICS_PORT=9465

# Postgres — a aplicação usa waychat_app (sujeita à RLS); migrações usam waychat_owner.
POSTGRES_OWNER_PASSWORD=dev-owner-password-change-me
POSTGRES_APP_PASSWORD=dev-app-password-change-me
POSTGRES_RELAY_PASSWORD=dev-relay-password-change-me
DATABASE_URL=postgres://waychat_app:dev-app-password-change-me@127.0.0.1:5462/waychat
DATABASE_OWNER_URL=postgres://waychat_owner:dev-owner-password-change-me@127.0.0.1:5462/waychat
# Usada só pelo relay do outbox (worker): lê eventos de todos os tenants, acesso restrito à tabela outbox.
DATABASE_RELAY_URL=postgres://waychat_relay:dev-relay-password-change-me@127.0.0.1:5462/waychat

# Valkey (filas, cache, pub/sub)
VALKEY_PASSWORD=dev-valkey-password-change-me
VALKEY_URL=redis://:dev-valkey-password-change-me@127.0.0.1:6409

# S3 compatível (MinIO em dev)
S3_ENDPOINT=http://127.0.0.1:9030
S3_REGION=us-east-1
S3_BUCKET=waychat
S3_ACCESS_KEY=waychat-dev
S3_SECRET_KEY=dev-s3-secret-change-me

# Chave mestra (AES-256-GCM, 32 bytes em base64) para segredos de integração. Rotação: docs/runbooks.
MASTER_KEY=
# Segredo para assinar tokens de sessão (mín. 32 caracteres).
SESSION_SECRET=

# Opcional: exportador OTLP (Jaeger, Tempo, Grafana Agent...). Vazio = traces desativados.
OTEL_EXPORTER_OTLP_ENDPOINT=
